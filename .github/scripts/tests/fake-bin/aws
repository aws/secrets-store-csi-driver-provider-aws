#!/usr/bin/env bash
#
# Test fake for the AWS CLI. Accepts only the exact ECR calls staging-image.sh makes:
#   aws ecr get-login-password --region <r> --cli-read-timeout 30 --cli-connect-timeout 10
#   aws ecr <describe-images | batch-get-image | put-image> --registry-id <id> --repository-name ascp --region <r>
#       <operation args> --output json --cli-read-timeout 30 --cli-connect-timeout 10
#
# $FAKE_DIR/aws.routes has one line per request: "<key> <reply>[,<reply>...]". The Nth call with a key gets the Nth
# reply (the last one repeats). Keys:
#   describe-images:imageTag=<tag>   describe-images:imageDigest=<digest>   batch-get-image:imageDigest=<digest>
#   put-image:<tag>                  get-login-password
# A reply is $FAKE_DIR/aws/<reply>.out (stdout), plus <reply>.err and <reply>.exit for a failure. Error text uses
# the format of a real AWS CLI v2 service error (recorded: a leading blank line, "aws: [ERROR]: An error occurred
# (<Name>) when calling the <Operation> operation: <message>", exit 254); the ECR names and messages are from the
# ECR API docs, not recorded.
#
# Every call is logged to $FAKE_DIR/aws.calls as "<args> | retry=<AWS_RETRY_MODE>,<AWS_MAX_ATTEMPTS>", with a
# put-image manifest path shown as file://MANIFEST (its bytes are copied to $FAKE_DIR/put-image.manifest).
# Anything unexpected is appended to $FAKE_VIOLATIONS and the fake exits 99.
#
# publish-image.sh's calls, handled before the ecr calls below:
#   aws ecr-public get-login-password --region us-east-1 --cli-read-timeout 30 --cli-connect-timeout 10
#   aws ecr-public describe-images --registry-id <id> --repository-name secrets-store-csi-driver-provider-aws
#       --region us-east-1 --image-ids imageTag=<tag> --output json --cli-read-timeout 30 --cli-connect-timeout 10
#   the same describe-images without --image-ids (the whole repo's listing; key public:describe-images)
#   aws sts assume-role --role-arn arn:aws:iam::<id>:role/<name> --role-session-name ascp-publish-<run>-<attempt>
#       --duration-seconds 3600 --tags Key=Repository,Value=<owner/repo> Key=RunId,Value=<run> --region us-east-1
#       --output json --cli-read-timeout 30 --cli-connect-timeout 10
# Route keys are prefixed "public:" (public:get-login-password, public:describe-images:imageTag=<tag>) or "sts:"
# (sts:assume-role), in the same routes file; these calls are logged to $FAKE_DIR/aws-public.calls in the same
# format as aws.calls.
# Every call, ecr ones included, is also appended to $FAKE_DIR/order.log as "aws <args> | key=<AWS_ACCESS_KEY_ID>",
# so a test can check the order of aws and crane calls and which credentials each aws call ran with.

set -euo pipefail

violation() {
	echo "aws: $*" >>"${FAKE_VIOLATIONS:?}"
	exit 99
}

echo "aws $* | key=${AWS_ACCESS_KEY_ID:-}" >>"$FAKE_DIR/order.log"

# replay <key> : prints the Nth reply routed for the key (the last one repeats), then exits with its status.
replay() {
	local key=$1 route calls index reply
	local -a replies
	echo "$key" >>"$FAKE_DIR/aws.keys"
	route=$(awk -v key="$key" '$1 == key { print $2 }' "$FAKE_DIR/aws.routes")
	[[ -n "$route" ]] || violation "no route for $key"
	calls=$(grep -cxF -- "$key" "$FAKE_DIR/aws.keys")
	IFS=, read -r -a replies <<<"$route"
	index=$((calls - 1))
	if ((index >= ${#replies[@]})); then
		index=$((${#replies[@]} - 1))
	fi
	reply="$FAKE_DIR/aws/${replies[$index]}"
	[[ -f "$reply.out" || -f "$reply.exit" ]] || violation "missing reply ${replies[$index]}"
	if [[ -f "$reply.out" ]]; then
		cat "$reply.out"
	fi
	if [[ -f "$reply.err" ]]; then
		cat "$reply.err" >&2
	fi
	if [[ -f "$reply.exit" ]]; then
		exit "$(cat "$reply.exit")"
	fi
	exit 0
}

# --- ecr-public and sts ------------------------------------------------------------------------------------------

if [[ "${1:-}" == ecr-public || "${1:-}" == sts ]]; then
	service=$1
	operation=${2:-}
	shift 2 || violation "unexpected call: $*"
	args=("$@")
	n=${#args[@]}
	if ((n < 4)) || [[ "${args[n - 4]}" != --cli-read-timeout || "${args[n - 3]}" != 30 ||
		"${args[n - 2]}" != --cli-connect-timeout || "${args[n - 1]}" != 10 ]]; then
		violation "unexpected $service $operation arguments: ${args[*]:-}"
	fi
	echo "$service $operation ${args[*]:-} | retry=${AWS_RETRY_MODE:-},${AWS_MAX_ATTEMPTS:-}" >>"$FAKE_DIR/aws-public.calls"
	case "$service $operation" in
	"ecr-public get-login-password")
		[[ $n -eq 6 && "${args[0]}" == --region && "${args[1]}" == us-east-1 ]] ||
			violation "unexpected get-login-password arguments: ${args[*]}"
		replay public:get-login-password
		;;
	"ecr-public describe-images")
		# The whole repo's listing (check-fresh): no --image-ids.
		if [[ $n -eq 12 && "${args[0]}" == --registry-id && "${args[1]}" =~ ^[0-9]{12}$ &&
			"${args[2]}" == --repository-name && "${args[3]}" == secrets-store-csi-driver-provider-aws &&
			"${args[4]}" == --region && "${args[5]}" == us-east-1 && "${args[6]}" == --output &&
			"${args[7]}" == json ]]; then
			replay public:describe-images
		fi
		[[ $n -eq 14 && "${args[0]}" == --registry-id && "${args[1]}" =~ ^[0-9]{12}$ &&
			"${args[2]}" == --repository-name &&
			"${args[3]}" == secrets-store-csi-driver-provider-aws &&
			"${args[4]}" == --region && "${args[5]}" == us-east-1 && "${args[6]}" == --image-ids &&
			"${args[7]}" =~ ^imageTag=[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ &&
			"${args[8]}" == --output && "${args[9]}" == json ]] ||
			violation "unexpected ecr-public describe-images arguments: ${args[*]:-}"
		replay "public:describe-images:${args[7]}"
		;;
	"sts assume-role")
		[[ $n -eq 17 && "${args[0]}" == --role-arn && "${args[1]}" =~ ^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ &&
			"${args[2]}" == --role-session-name && "${args[3]}" =~ ^ascp-publish-[0-9]+-[0-9]+$ &&
			"${args[4]}" == --duration-seconds && "${args[5]}" == 3600 && "${args[6]}" == --tags &&
			"${args[7]}" =~ ^Key=Repository,Value=[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ &&
			"${args[8]}" =~ ^Key=RunId,Value=[0-9]+$ && "${args[9]}" == --region && "${args[10]}" == us-east-1 &&
			"${args[11]}" == --output && "${args[12]}" == json ]] ||
			violation "unexpected sts assume-role arguments: ${args[*]}"
		replay sts:assume-role
		;;
	*) violation "unexpected $service operation: $operation" ;;
	esac
fi

# --- ecr ---------------------------------------------------------------------------------------------------------

[[ $# -ge 2 && "$1" == ecr ]] || violation "unexpected call: $*"
operation=$2
shift 2
args=("$@")
retry="retry=${AWS_RETRY_MODE:-},${AWS_MAX_ATTEMPTS:-}"

timeouts_at_end() {
	local n=${#args[@]}
	((n >= 4)) && [[ "${args[n - 4]}" == --cli-read-timeout && "${args[n - 3]}" == 30 &&
		"${args[n - 2]}" == --cli-connect-timeout && "${args[n - 1]}" == 10 ]]
}

case "$operation" in
get-login-password)
	if [[ ${#args[@]} -ne 6 || "${args[0]}" != --region ]] || ! timeouts_at_end; then
		violation "unexpected get-login-password arguments: ${args[*]}"
	fi
	key=get-login-password
	logged="$operation ${args[*]}"
	;;
describe-images | batch-get-image | put-image)
	n=${#args[@]}
	if ((n < 12)) || [[ "${args[0]}" != --registry-id || ! "${args[1]}" =~ ^[0-9]{12}$ ||
		"${args[2]}" != --repository-name || "${args[3]}" != ascp || "${args[4]}" != --region ||
		"${args[n - 6]}" != --output || "${args[n - 5]}" != json ]] || ! timeouts_at_end; then
		violation "unexpected $operation arguments: ${args[*]}"
	fi
	middle=("${args[@]:6:n-12}")
	logged="$operation ${args[*]}"
	case "$operation" in
	describe-images | batch-get-image)
		[[ ${#middle[@]} -eq 2 && "${middle[0]}" == --image-ids &&
			"${middle[1]}" =~ ^(imageTag|imageDigest)=[^,[:space:]]+$ ]] ||
			violation "unexpected $operation image ids: ${middle[*]}"
		if [[ "$operation" == batch-get-image && "${middle[1]}" != imageDigest=* ]]; then
			violation "batch-get-image by tag: ${middle[*]}"
		fi
		key="$operation:${middle[1]}"
		;;
	put-image)
		[[ ${#middle[@]} -eq 8 && "${middle[0]}" == --image-tag && "${middle[2]}" == --image-digest &&
			"${middle[4]}" == --image-manifest && "${middle[5]}" == file://* &&
			"${middle[6]}" == --image-manifest-media-type ]] ||
			violation "unexpected put-image arguments: ${middle[*]}"
		manifest=${middle[5]#file://}
		[[ -f "$manifest" ]] || violation "put-image manifest file $manifest is missing"
		cp "$manifest" "$FAKE_DIR/put-image.manifest"
		logged=$operation
		for arg in "${args[@]}"; do
			if [[ "$arg" == "file://$manifest" ]]; then
				arg=file://MANIFEST
			fi
			logged="$logged $arg"
		done
		key="put-image:${middle[1]}"
		;;
	esac
	;;
*) violation "unexpected ecr operation: $operation" ;;
esac

echo "$logged | $retry" >>"$FAKE_DIR/aws.calls"
echo "$key" >>"$FAKE_DIR/aws.keys"

route=$(awk -v key="$key" '$1 == key { print $2 }' "$FAKE_DIR/aws.routes")
[[ -n "$route" ]] || violation "no route for $key"
calls=$(grep -cxF -- "$key" "$FAKE_DIR/aws.keys")
IFS=, read -r -a replies <<<"$route"
index=$((calls - 1))
if ((index >= ${#replies[@]})); then
	index=$((${#replies[@]} - 1))
fi
reply="$FAKE_DIR/aws/${replies[$index]}"

[[ -f "$reply.out" || -f "$reply.exit" ]] || violation "missing reply ${replies[$index]}"
if [[ -f "$reply.out" ]]; then
	cat "$reply.out"
fi
if [[ -f "$reply.err" ]]; then
	cat "$reply.err" >&2
fi
if [[ -f "$reply.exit" ]]; then
	exit "$(cat "$reply.exit")"
fi
