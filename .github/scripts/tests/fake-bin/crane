#!/usr/bin/env bash
#
# Test fake for crane. Accepts only the call validate-release-version.sh makes:
#   crane ls public.ecr.aws/aws-secrets-manager/secrets-store-csi-driver-provider-aws
# and prints $FAKE_DIR/crane-tags, one tag per line as crane does. Tests make that file with crane_tags, from
# fixtures/ecr-public-tags.txt (recorded with crane v0.22.1 `crane ls`, anonymous, on 2026-11-24) or made-up tags. With
# $FAKE_DIR/crane-ls.exit, it prints a made-up error to stderr and exits with that status instead.
# Every call is logged to $FAKE_DIR/crane.calls. Anything unexpected is appended to $FAKE_VIOLATIONS, exit 99.

set -euo pipefail

violation() {
	echo "crane: $*" >>"${FAKE_VIOLATIONS:?}"
	exit 99
}

echo "$*" >>"$FAKE_DIR/crane.calls"

if [[ $# -ne 2 || "$1" != ls || "$2" != public.ecr.aws/aws-secrets-manager/secrets-store-csi-driver-provider-aws ]]; then
	violation "unexpected call: $*"
fi
if [[ -f "$FAKE_DIR/crane-ls.exit" ]]; then
	echo "Error: made-up crane failure" >&2
	exit "$(cat "$FAKE_DIR/crane-ls.exit")"
fi
[[ -f "$FAKE_DIR/crane-tags" ]] || violation "no tags set up (crane_tags)"
cat "$FAKE_DIR/crane-tags"
