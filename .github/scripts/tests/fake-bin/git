#!/usr/bin/env bash
#
# Test fake for git: a checker in front of real git. Accepts only the exact `git ls-remote` call
# validate-release-version.sh makes, then runs the real git ($FAKE_REAL_GIT). The tests point the GitHub URL at a
# local bare repo (GIT_CONFIG_* insteadOf), so the answer comes from real git on real tags.
# With FAKE_REAL_GIT set (bump-manifest.bats), any other call whose first argument is -C runs that real git on a
# local test repo instead.
# Every call is logged to $FAKE_DIR/git.calls. Anything unexpected goes to $FAKE_VIOLATIONS, exit 99.

set -euo pipefail

violation() {
	echo "git: $*" >>"${FAKE_VIOLATIONS:?}"
	exit 99
}

echo "$*" >>"$FAKE_DIR/git.calls"

[[ "${GIT_TERMINAL_PROMPT:-}" == 0 ]] || violation "GIT_TERMINAL_PROMPT is '${GIT_TERMINAL_PROMPT:-}', not 0"
if [[ -n "${FAKE_REAL_GIT:-}" && "${1:-}" == -C ]]; then
	exec "$FAKE_REAL_GIT" "$@"
fi
if [[ $# -ne 10 || "$1" != -c || "$2" != http.lowSpeedLimit=1000 || "$3" != -c || "$4" != http.lowSpeedTime=20 ||
	"$5" != ls-remote || "$6" != --exit-code || "$7" != --tags ]]; then
	violation "unexpected arguments: $*"
fi
[[ "$8" == "https://github.com/aws/secrets-store-csi-driver-provider-aws" ]] || violation "unexpected repo URL: $8"
version=${9#refs/tags/}
[[ "$9" == "refs/tags/$version" && -n "$version" ]] || violation "unexpected first ref: $9"
[[ "${10}" == "refs/tags/secrets-store-csi-driver-provider-aws-$version" ]] || violation "unexpected second ref: ${10}"
[[ -n "${FAKE_REAL_GIT:-}" ]] || violation "FAKE_REAL_GIT is not set"

# Run outside the checkout, so its .git/config (which may rewrite GitHub URLs) can't apply, and allow only file://,
# so a rewrite that misses the local repo fails instead of reaching the network.
cd "$FAKE_DIR"
export GIT_ALLOW_PROTOCOL=file
exec "$FAKE_REAL_GIT" "$@"
