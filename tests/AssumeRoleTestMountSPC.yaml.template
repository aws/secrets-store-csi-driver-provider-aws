apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ${ASSUME_ROLE_NAME}
spec:
  provider: aws
  parameters:{{POD_IDENTITY_PARAM}}
    region: ${REGION}
    failoverRegion: ${FAILOVERREGION}
    assumeRoleArn: "${ASSUME_ROLE_ARN}"
    objects: |
      - objectName: "AssumeRoleSecretTest-{{ARCH}}-{{AUTH_TYPE}}"
        objectType: "secretsmanager"
      - objectName: "AssumeRoleRotationTest-{{ARCH}}-{{AUTH_TYPE}}"
        objectType: "secretsmanager"
      - objectName: "AssumeRoleParameterTest-{{ARCH}}-{{AUTH_TYPE}}"
        objectType: "ssmparameter"
