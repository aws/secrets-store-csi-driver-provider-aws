kind: Pod
apiVersion: v1
metadata:
  name: ${ASSUME_ROLE_NAME}
spec:
  serviceAccountName: assume-role-test-sa-{{ARCH}}-{{AUTH_TYPE}}
  containers:
    - image: k8s.gcr.io/e2e-test-images/busybox:1.29
      name: busybox
      imagePullPolicy: IfNotPresent
      command:
        - "/bin/sleep"
        - "10000"
      volumeMounts:
        - name: secrets-store-inline
          mountPath: "/mnt/secrets-store"
          readOnly: true
  volumes:
    - name: secrets-store-inline
      csi:
        driver: secrets-store.csi.k8s.io
        readOnly: true
        volumeAttributes:
          secretProviderClass: "${ASSUME_ROLE_NAME}"
